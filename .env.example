# ---------------------------------------------------------------------------
# Finances — environment variables
# Copy to `.env.local` for local development. NEVER commit real values.
# On Vercel, add them in Project → Settings → Environment Variables
# (the Neon integration adds DATABASE_URL / DATABASE_URL_UNPOOLED for you).
# ---------------------------------------------------------------------------

# REQUIRED. Postgres connection string used at runtime.
# On Vercel + Neon use the *pooled* URL (host contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# OPTIONAL. Direct (unpooled) URL. Used only by migrations (`npm run db:migrate`),
# because migrations take a session-level advisory lock. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# RECOMMENDED. Random string (e.g. `openssl rand -hex 32`). Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>` to /api/cron/recurring. Without it the
# cron endpoint is disabled (recurring movements are still generated whenever
# the user opens the app).
CRON_SECRET="change-me"
